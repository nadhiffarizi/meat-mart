// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// enum
enum E_Role {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
}

enum E_StoreStatus {
  CENTRAL
  BRANCH
}

enum E_PromotionType {
  CUSTOM
  MINIMUM_BUY
  BOGO // buy 1 get 1
}

enum E_TransactionStatus {
  CANCELED
  AWAITING_PAYMENT
  PENDING_ADMIN
  CONFIRMED_ADMIN
  DONE
}

enum E_OrderStatus {
  CANCELED
  AWAITING_PAYMENT
  PENDING_ADMIN
  ON_PROCESS
  ON_DELIVERY
  CONFIRMED
}

enum E_StockStatus {
  ADD
  SUBTRACT
  SNAPSHOT
}

// model
model Users {
  id                  String               @id @default(uuid())
  first_name          String?
  last_name           String?
  email               String               @unique
  password            String?
  image_url           String?
  role                E_Role               @default(CUSTOMER)
  phone_number        String?
  is_verified         Boolean              @default(false)
  verification_link   String?              @unique
  verification_expiry DateTime?
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt()
  deleted_at          DateTime?
  provider            String?              @default("credentials")
  provider_id         String?              @unique
  UserAddresses       UserAddresses[]
  Stores              Stores[]
  Carts               Carts[]
  Transactions        Transactions[]
  TransactionDetails  TransactionDetails[]

  @@map("users")
}

model UserAddresses {
  id                     String   @id @default(uuid())
  user_id                String
  users                  Users    @relation(fields: [user_id], references: [id])
  recipient_name         String
  recipient_phone_number String
  is_selected            Boolean
  address                String
  province               String
  city                   String
  district               String
  postal_code            String
  latitude               String
  longitude              String
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt()
  // deleted_at             DateTime?

  @@map("addresses")
}

model Products {
  id                 String               @id @default(uuid())
  name               String
  slug               String               @unique
  price              Float
  weight             Float
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt()
  deleted_at         DateTime?
  ProductPictures    ProductPictures[]
  Stocks             Stocks[]
  Categories         Categories[]
  Discounts          Discounts[]
  TransactionDetails TransactionDetails[]
  StockHistory       StockHistory[]

  @@map("products")
}

model Categories {
  id         String    @id @default(uuid())
  name       String
  product_id String
  products   Products  @relation(fields: [product_id], references: [id])
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt()
  deleted_at DateTime?

  @@map("categories")
}

model ProductPictures {
  id               String    @id @default(uuid())
  product_id       String
  products         Products  @relation(fields: [product_id], references: [id])
  link             String
  thumbnail_status Boolean
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt()
  deleted_at       DateTime?

  @@map("productpictures")
}

model Stocks {
  id                 String               @id @default(uuid())
  product_id         String
  products           Products             @relation(fields: [product_id], references: [id])
  store_id           String
  stores             Stores               @relation(fields: [store_id], references: [id])
  quantity           Int
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt()
  deleted_at         DateTime?
  Carts              Carts[]
  TransactionDetails TransactionDetails[]

  @@map("stocks")
}

model Stores {
  id                 String               @id @default(uuid())
  storeadmin_id      String
  storeadmin         Users                @relation(fields: [storeadmin_id], references: [id])
  name               String
  status             E_StoreStatus
  address            String
  province           String
  city               String
  district           String
  postal_code        String
  latitude           String
  longitude          String
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt()
  deleted_at         DateTime?
  Discounts          Discounts[]
  TransactionDetails TransactionDetails[]
  StockHistory       StockHistory[]
  Stocks             Stocks[]

  @@map("stores")
}

model Discounts {
  id                      String          @id @default(uuid())
  product_id              String
  products                Products        @relation(fields: [product_id], references: [id])
  store_id                String
  stores                  Stores          @relation(fields: [store_id], references: [id])
  start_date              DateTime
  end_date                DateTime
  discount_code           String          @unique
  promotion_type          E_PromotionType
  discount_percentage     Float?
  discount_amount         Float?
  maximum_discount_amount Float?
  minimum_purchase        Float?
  is_valid                Boolean
  created_at              DateTime        @default(now())
  updated_at              DateTime        @updatedAt()
  deleted_at              DateTime?

  @@map("discounts")
}

model Carts {
  id         String    @id @default(uuid())
  user_id    String
  users      Users     @relation(fields: [user_id], references: [id])
  stock_id   String
  stocks     Stocks    @relation(fields: [stock_id], references: [id])
  quantity   Int
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt()
  deleted_at DateTime?

  @@map("carts")
}

model Transactions {
  id                 String               @id @default(uuid())
  total_price        Float
  minimum_buy        Boolean?
  amount_discount    Float?
  deadline_payment   DateTime
  transaction_status E_TransactionStatus
  payment_proof      String?
  users_id           String
  users              Users                @relation(fields: [users_id], references: [id])
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt()
  deleted_at         DateTime?
  TransactionDetails TransactionDetails[]

  @@map("transactions")
}

model TransactionDetails {
  id                String               @id @default(uuid())
  transaction_id    String
  transactions      Transactions         @relation(fields: [transaction_id], references: [id])
  stock_id          String
  stocks            Stocks               @relation(fields: [stock_id], references: [id])
  users_id          String
  users             Users                @relation(fields: [users_id], references: [id])
  quantity          Int
  price_per_product Float
  shipping_cost     Float
  sub_total         Float
  store_id          String
  stores            Stores               @relation(fields: [store_id], references: [id])
  product_id        String
  products          Products             @relation(fields: [product_id], references: [id])
  discounted        Boolean
  discount_code     String?
  created_at        DateTime             @default(now())
  updated_at        DateTime             @updatedAt()
  deleted_at        DateTime?
  OrderStatus       OrderStatusHistory[]

  @@map("transactiondetails")
}

model OrderStatusHistory {
  id                    String             @id @default(uuid())
  transaction_detail_id String
  transaction_details   TransactionDetails @relation(fields: [transaction_detail_id], references: [id])
  status                E_OrderStatus
  created_at            DateTime           @default(now())
  updated_at            DateTime           @updatedAt()
  deleted_at            DateTime?

  @@map("orderstatushistory")
}

model StockHistory {
  id         String        @id @default(uuid())
  product_id String
  products   Products      @relation(fields: [product_id], references: [id])
  store_id   String
  stores     Stores        @relation(fields: [store_id], references: [id])
  quantity   Int
  status     E_StockStatus
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt()
  deleted_at DateTime?

  @@map("stockhistory")
}
